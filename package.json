{
  "name": "my-bilibili-rcmd",
  "version": "0.2.0",
  "description": "用 LLM 看你的 B 站行为生成兴趣画像，自动过滤推荐流",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:promo": "vite -c vite.config.promo.ts",
    "build": "vite build",
    "build:promo": "vite build -c vite.config.promo.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:bundle": "bash scripts/check-bundle.sh"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@tailwindcss/vite": "^4.3.0",
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
