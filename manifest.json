{
  "manifest_version": 3,
  "name": "我的 Bilibili 推荐",
  "version": "0.1.2",
  "description": "用 LLM 看你的 B 站行为生成兴趣画像，自动过滤推荐流",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.bilibili.com/*",
    "https://openrouter.ai/*",
    "https://open.bigmodel.cn/*",
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*"
      ],
      "js": [
        "src/content/main-world-helper.ts"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.bilibili.com/*"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "我的 Bilibili 推荐",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
